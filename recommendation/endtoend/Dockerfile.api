# 상품 추천 시스템 — 추론 API 서빙용 이미지.
#
# Dockerfile(개발/학습용), Dockerfile.gpu(GPU 학습용)와는 별도로,
# 실제 배포 시 띄우는 FastAPI 추론 서버(src/api/main.py)만 담당한다.
# requirements.txt(학습용, torch/transformers/datasets/accelerate/sentence-transformers 포함)는
# 빌드 환경 임시 저장공간 한도(6GB)를 초과해 CI 빌드가 실패했음(인프라팀 확인).
# 추론 서버는 그 패키지들이 필요 없어서, requirements-api.txt(경량 버전)를 대신 사용한다.

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY . .

ENV USE_DUMMY_DATA=false
ENV PYTHONUNBUFFERED=1

# 2026-09-28: petflow/recommendation ECR 레포 terraform apply 완료 후 재트리거.
EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]