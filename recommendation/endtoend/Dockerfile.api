# 상품 추천 시스템 — 추론 API 서빙용 이미지.
#
# Dockerfile(개발/학습용), Dockerfile.gpu(GPU 학습용)와는 별도로,
# 실제 배포 시 띄우는 FastAPI 추론 서버(src/api/main.py)만 담당한다.
# 학습에 필요한 무거운 패키지(datasets/accelerate/sentence-transformers 등)까지
# requirements.txt에 다 들어있어 이미지가 크지만, 우선은 동일한 requirements.txt를
# 재사용해 학습 코드와 추론 코드가 항상 같은 의존성 버전을 쓰도록 맞췄다.
# (이후 배포 이미지를 가볍게 만들고 싶으면 requirements-api.txt로 분리 예정)
#
# 2026-09-28: recommendation CI/CD 첫 실배포 트리거 (Jenkinsfile만 바뀐 PR은
# changedServices 경로 diff에서 감지되지 않아 별도로 이 경로에 커밋 필요).

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# 배포 환경에서는 실제 DB를 쓰도록 USE_DUMMY_DATA=false, DATABASE_URL을
# 컨테이너 실행 시 -e 옵션(또는 오케스트레이션 매니페스트)으로 주입한다.
ENV USE_DUMMY_DATA=false
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# models/deepfm/ (feature_encoder.json, model_config.json, deepfm_model.pt)은
# 학습 산출물이므로 이미지 빌드 시 COPY되거나, 볼륨/스토리지에서 마운트되어야 한다.
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]